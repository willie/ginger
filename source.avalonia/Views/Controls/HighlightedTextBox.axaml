<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="Ginger.Views.Controls.HighlightedTextBox">
    <Grid>
        <ae:TextEditor x:Name="TextEditor"
                       ShowLineNumbers="False"
                       HorizontalScrollBarVisibility="Disabled"
                       VerticalScrollBarVisibility="Auto"
                       Background="Transparent"
                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        <!-- Canvas overlay for search highlights (works without focus) -->
        <Canvas x:Name="HighlightCanvas" IsHitTestVisible="False">
            <Border x:Name="HighlightRect"
                    Background="#80FFD700"
                    IsVisible="False"/>
        </Canvas>
    </Grid>
</UserControl>
