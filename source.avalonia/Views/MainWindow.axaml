<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ginger.ViewModels"
        xmlns:conv="using:Ginger.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Ginger.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <conv:BoolToOpacityConverter x:Key="BoolToOpacityConverter" TrueValue="0.4" FalseValue="1.0"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Expander">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#PART_toggle">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" FontSize="12">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="{Binding NewCommand}" InputGesture="Ctrl+N"/>
                <MenuItem Header="New from _Template">
                    <MenuItem Header="Assistant" Command="{Binding NewFromTemplateCommand}" CommandParameter="assistant"/>
                    <MenuItem Header="Chat Bot" Command="{Binding NewFromTemplateCommand}" CommandParameter="chat-bot"/>
                    <MenuItem Header="Classic" Command="{Binding NewFromTemplateCommand}" CommandParameter="classic"/>
                    <MenuItem Header="Companion" Command="{Binding NewFromTemplateCommand}" CommandParameter="companion"/>
                    <MenuItem Header="Roleplay" Command="{Binding NewFromTemplateCommand}" CommandParameter="roleplay"/>
                </MenuItem>
                <MenuItem Header="New _Window" Command="{Binding NewWindowCommand}"/>
                <MenuItem Header="_Duplicate" Command="{Binding DuplicateCommand}" InputGesture="Ctrl+D"/>
                <Separator/>
                <MenuItem Header="_Open..." Command="{Binding OpenCommand}" InputGesture="Ctrl+O"/>
                <MenuItem Header="Open _Recent" ItemsSource="{Binding RecentFiles}" x:CompileBindings="False">
                    <MenuItem.Styles>
                        <Style Selector="MenuItem > MenuItem">
                            <Setter Property="Header" Value="{Binding DisplayName}"/>
                            <Setter Property="Command" Value="{Binding $parent[MenuItem].DataContext.OpenRecentFileCommand}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.Styles>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGesture="Ctrl+S"/>
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S"/>
                <MenuItem Header="Save _Incremental" Command="{Binding SaveIncrementalCommand}"/>
                <MenuItem Header="_Revert to Saved" Command="{Binding RevertFileCommand}"/>
                <Separator/>
                <MenuItem Header="_Import">
                    <MenuItem Header="Import from _Folder..." Command="{Binding ImportFromFolderCommand}"/>
                    <MenuItem Header="Import from _URL..." Command="{Binding ImportFromUrlCommand}"/>
                    <MenuItem Header="Import from _Clipboard..." Command="{Binding ImportFromClipboardCommand}"/>
                </MenuItem>
                <MenuItem Header="_Export">
                    <MenuItem Header="Export _As..." Command="{Binding ExportAsCommand}" InputGesture="Ctrl+E"/>
                    <Separator/>
                    <MenuItem Header="Export to _Folder..." Command="{Binding ExportToFolderCommand}"/>
                    <MenuItem Header="Export as _JSON..." Command="{Binding ExportAsJsonCommand}"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z"
                          IsEnabled="{Binding CanUndo}"/>
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y"
                          IsEnabled="{Binding CanRedo}"/>
                <Separator/>
                <MenuItem Header="_Find..." Command="{Binding FindCommand}" InputGesture="Ctrl+F"/>
                <MenuItem Header="Find _Next" Command="{Binding FindNextCommand}" InputGesture="F3"/>
                <MenuItem Header="Find _Previous" Command="{Binding FindPreviousCommand}" InputGesture="Shift+F3"/>
                <MenuItem Header="Find and _Replace..." Command="{Binding FindReplaceCommand}" InputGesture="Ctrl+H"/>
                <Separator/>
                <MenuItem Header="Copy All _Recipes" Command="{Binding CopyAllRecipesCommand}" InputGesture="Ctrl+Shift+C"/>
                <MenuItem Header="_Paste Recipes" Command="{Binding PasteRecipesCommand}" InputGesture="Ctrl+Shift+V"/>
                <Separator/>
                <MenuItem Header="_Load Portrait..." Command="{Binding LoadPortraitCommand}" InputGesture="Ctrl+L"/>
                <MenuItem Header="_Clear Portrait" Command="{Binding ClearPortraitCommand}"/>
                <Separator/>
                <MenuItem Header="Load _Background..." Command="{Binding LoadBackgroundCommand}"/>
                <MenuItem Header="Background Effects">
                    <MenuItem Header="Blur" Command="{Binding BlurBackgroundCommand}"/>
                    <MenuItem Header="Darken" Command="{Binding DarkenBackgroundCommand}"/>
                    <MenuItem Header="Desaturate" Command="{Binding DesaturateBackgroundCommand}"/>
                </MenuItem>
                <MenuItem Header="Clear Background" Command="{Binding ClearBackgroundCommand}"/>
                <Separator/>
                <MenuItem Header="Edit in _Window">
                    <MenuItem Header="_Persona..." Command="{Binding EditPersonaCommand}"/>
                    <MenuItem Header="Perso_nality..." Command="{Binding EditPersonalityCommand}"/>
                    <MenuItem Header="_Scenario..." Command="{Binding EditScenarioCommand}"/>
                    <MenuItem Header="_Greeting..." Command="{Binding EditGreetingCommand}"/>
                    <MenuItem Header="_Example Messages..." Command="{Binding EditExampleMessagesCommand}"/>
                    <MenuItem Header="S_ystem Prompt..." Command="{Binding EditSystemPromptCommand}"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Dark Mode" Command="{Binding ToggleDarkModeCommand}">
                    <MenuItem.Icon>
                        <CheckBox IsChecked="{Binding IsDarkMode}" BorderThickness="0"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Show Recipe _Category" Command="{Binding ToggleShowRecipeCategoryCommand}">
                    <MenuItem.Icon>
                        <CheckBox IsChecked="{Binding ShowRecipeCategory}" BorderThickness="0"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Sort Recipes">
                    <MenuItem Header="By _Name" Command="{Binding SortRecipesByNameCommand}"/>
                    <MenuItem Header="By _Category" Command="{Binding SortRecipesByCategoryCommand}"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Expand All" Command="{Binding ExpandAllCommand}" InputGesture="Ctrl+E"/>
                <MenuItem Header="_Collapse All" Command="{Binding CollapseAllCommand}" InputGesture="Ctrl+Shift+E"/>
            </MenuItem>
            <MenuItem Header="_Actors">
                <MenuItem Header="_Add Actor" Command="{Binding AddActorCommand}"/>
                <MenuItem Header="_Import Actor..." Command="{Binding ImportActorCommand}"/>
                <MenuItem Header="E_xport Actor..." Command="{Binding ExportActorCommand}"
                          IsEnabled="{Binding CanRemoveActor}"/>
                <Separator/>
                <MenuItem Header="_Remove Actor" Command="{Binding RemoveActorCommand}"
                          IsEnabled="{Binding CanRemoveActor}"/>
                <MenuItem Header="Re_arrange Actors..." Command="{Binding RearrangeActorsCommand}"
                          IsEnabled="{Binding CanRemoveActor}"/>
            </MenuItem>
            <MenuItem Header="_Lorebook">
                <MenuItem Header="_Import Lorebook..." Command="{Binding ImportLorebookCommand}"/>
                <MenuItem Header="_Export Lorebook">
                    <MenuItem Header="As _Ginger Format..." Command="{Binding ExportLorebookAsGingerCommand}"/>
                    <MenuItem Header="As _SillyTavern Format..." Command="{Binding ExportLorebookAsTavernCommand}"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Copy All Entries" Command="{Binding CopyLorebookCommand}"/>
                <MenuItem Header="_Paste Entries" Command="{Binding PasteLorebookCommand}"/>
                <Separator/>
                <MenuItem Header="_Sort">
                    <MenuItem Header="By _Name" Command="{Binding SortLorebookByNameCommand}"/>
                    <MenuItem Header="By _Keys" Command="{Binding SortLorebookByKeysCommand}"/>
                    <MenuItem Header="By _Insertion Order" Command="{Binding SortLorebookByInsertionOrderCommand}"/>
                    <MenuItem Header="By _Priority" Command="{Binding SortLorebookByPriorityCommand}"/>
                    <MenuItem Header="By _Token Count" Command="{Binding SortLorebookByTokenCountCommand}"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Header="_Token Budget">
                    <MenuItem Header="None" Command="{Binding SetTokenBudgetCommand}" CommandParameter="None"/>
                    <Separator/>
                    <MenuItem Header="1024 tokens" Command="{Binding SetTokenBudgetCommand}" CommandParameter="1024 tokens"/>
                    <MenuItem Header="2048 tokens" Command="{Binding SetTokenBudgetCommand}" CommandParameter="2048 tokens"/>
                    <MenuItem Header="4096 tokens" Command="{Binding SetTokenBudgetCommand}" CommandParameter="4096 tokens"/>
                    <MenuItem Header="6144 tokens" Command="{Binding SetTokenBudgetCommand}" CommandParameter="6144 tokens"/>
                    <MenuItem Header="8192 tokens" Command="{Binding SetTokenBudgetCommand}" CommandParameter="8192 tokens"/>
                    <MenuItem Header="12288 tokens" Command="{Binding SetTokenBudgetCommand}" CommandParameter="12288 tokens"/>
                    <MenuItem Header="16384 tokens" Command="{Binding SetTokenBudgetCommand}" CommandParameter="16384 tokens"/>
                    <MenuItem Header="24576 tokens" Command="{Binding SetTokenBudgetCommand}" CommandParameter="24576 tokens"/>
                    <MenuItem Header="32768 tokens" Command="{Binding SetTokenBudgetCommand}" CommandParameter="32768 tokens"/>
                </MenuItem>
                <MenuItem Header="_Output Preview">
                    <MenuItem Header="Default" Command="{Binding SetOutputPreviewCommand}" CommandParameter="Default"/>
                    <MenuItem Header="SillyTavern" Command="{Binding SetOutputPreviewCommand}" CommandParameter="SillyTavern"/>
                    <MenuItem Header="Faraday" Command="{Binding SetOutputPreviewCommand}" CommandParameter="Faraday"/>
                    <MenuItem Header="Faraday (Party)" Command="{Binding SetOutputPreviewCommand}" CommandParameter="Faraday (Party)"/>
                    <MenuItem Header="Plain Text" Command="{Binding SetOutputPreviewCommand}" CommandParameter="Plain Text"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Spell Checking" Command="{Binding ToggleSpellCheckCommand}">
                    <MenuItem.Icon>
                        <CheckBox IsChecked="{Binding SpellCheckEnabled}" BorderThickness="0"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Spell Check _Language">
                    <MenuItem Header="English (US)" Command="{Binding SelectDictionaryByLocaleCommand}" CommandParameter="en_US"/>
                    <MenuItem Header="English (UK)" Command="{Binding SelectDictionaryByLocaleCommand}" CommandParameter="en_GB"/>
                </MenuItem>
                <MenuItem Header="Auto Convert _Name" Command="{Binding ToggleAutoConvertNameCommand}">
                    <MenuItem.Icon>
                        <CheckBox IsChecked="{Binding AutoConvertName}" BorderThickness="0"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Auto _Break" Command="{Binding ToggleAutoBreakCommand}">
                    <MenuItem.Icon>
                        <CheckBox IsChecked="{Binding AutoBreak}" BorderThickness="0"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Rearrange Lore" Command="{Binding ToggleRearrangeLoreCommand}">
                    <MenuItem.Icon>
                        <CheckBox IsChecked="{Binding RearrangeLoreEnabled}" BorderThickness="0"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Allow NSFW" Command="{Binding ToggleNsfwCommand}">
                    <MenuItem.Icon>
                        <CheckBox IsChecked="{Binding AllowNsfw}" BorderThickness="0"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Language">
                    <MenuItem Header="English" Command="{Binding ChangeLanguageCommand}" CommandParameter="en"/>
                    <MenuItem Header="Español" Command="{Binding ChangeLanguageCommand}" CommandParameter="es"/>
                    <MenuItem Header="Français" Command="{Binding ChangeLanguageCommand}" CommandParameter="fr"/>
                    <MenuItem Header="Deutsch" Command="{Binding ChangeLanguageCommand}" CommandParameter="de"/>
                    <MenuItem Header="日本語" Command="{Binding ChangeLanguageCommand}" CommandParameter="ja"/>
                    <MenuItem Header="中文" Command="{Binding ChangeLanguageCommand}" CommandParameter="zh"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Find..." Command="{Binding FindCommand}" InputGesture="Ctrl+F"/>
                <MenuItem Header="Find and _Replace..." Command="{Binding FindReplaceCommand}" InputGesture="Ctrl+H"/>
                <Separator/>
                <MenuItem Header="_Gender Swap..." Command="{Binding GenderSwapCommand}"/>
                <Separator/>
                <MenuItem Header="_Variables..." Command="{Binding EditVariablesCommand}"/>
                <MenuItem Header="_Embedded Assets..." Command="{Binding EditAssetsCommand}"/>
                <Separator/>
                <MenuItem Header="_Browse Recipes..." Command="{Binding BrowseRecipesCommand}"/>
                <MenuItem Header="Create _Recipe..." Command="{Binding CreateRecipeCommand}"/>
                <MenuItem Header="Create _Snippet..." Command="{Binding CreateSnippetCommand}"/>
                <Separator/>
                <MenuItem Header="Bake _All" Command="{Binding BakeAllCommand}"/>
                <MenuItem Header="Bake A_ctor" Command="{Binding BakeActorCommand}"/>
                <MenuItem Header="_Merge Lore" Command="{Binding MergeLoreCommand}"/>
                <Separator/>
                <MenuItem Header="Reload Recipes" Command="{Binding ReloadRecipesCommand}" InputGesture="F5"/>
            </MenuItem>
            <MenuItem Header="_Backyard">
                <MenuItem Header="_Browse Characters..." Command="{Binding BrowseBackyardCommand}"/>
                <MenuItem Header="_Export All to Folder..." Command="{Binding ExportAllBackyardCommand}"/>
                <MenuItem Header="_Import Folder to Backyard..." Command="{Binding ImportFolderToBackyardCommand}"/>
                <Separator/>
                <MenuItem Header="_Connect" Command="{Binding ConnectBackyardCommand}"/>
                <MenuItem Header="_Disconnect" Command="{Binding DisconnectBackyardCommand}"/>
                <Separator/>
                <MenuItem Header="_Link Character" Command="{Binding LinkCharacterCommand}"/>
                <MenuItem Header="_Unlink Character" Command="{Binding UnlinkCharacterCommand}"/>
                <MenuItem Header="_Reestablish Link" Command="{Binding ReestablishLinkCommand}"/>
                <Separator/>
                <MenuItem Header="_Push Changes" Command="{Binding PushChangesCommand}" InputGesture="Ctrl+U"/>
                <MenuItem Header="P_ull Changes" Command="{Binding PullChangesCommand}" InputGesture="Ctrl+Shift+U"/>
                <MenuItem Header="_Save Linked" Command="{Binding SaveLinkedCommand}" InputGesture="Ctrl+Shift+S"/>
                <MenuItem Header="Save as _New..." Command="{Binding SaveNewLinkedCommand}"/>
                <MenuItem Header="Save as New _Party..." Command="{Binding SaveAsNewPartyCommand}"/>
                <MenuItem Header="_Revert to Backyard" Command="{Binding RevertLinkedCommand}"/>
                <Separator/>
                <MenuItem Header="_Chat History..." Command="{Binding ShowChatHistoryCommand}"/>
                <MenuItem Header="Edit _Model Settings..." Command="{Binding EditModelSettingsCommand}"/>
                <MenuItem Header="_Bulk Edit Model Settings..." Command="{Binding BulkEditModelSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="_Utilities">
                    <MenuItem Header="Create _Backup..." Command="{Binding CreateBackyardBackupCommand}"/>
                    <MenuItem Header="_Restore Backup..." Command="{Binding RestoreBackyardBackupCommand}"/>
                    <Separator/>
                    <MenuItem Header="_Bulk Export Parties..." Command="{Binding BulkExportPartiesCommand}"/>
                    <MenuItem Header="_Delete Characters..." Command="{Binding DeleteCharactersCommand}"/>
                    <Separator/>
                    <MenuItem Header="_Purge Unused Images" Command="{Binding PurgeUnusedImagesCommand}"/>
                    <MenuItem Header="Repair _Broken Images" Command="{Binding RepairBrokenImagesCommand}"/>
                    <MenuItem Header="Repair _Legacy Chats" Command="{Binding RepairLegacyChatsCommand}"/>
                    <Separator/>
                    <MenuItem Header="Reset _Models Location" Command="{Binding ResetModelsLocationCommand}"/>
                    <MenuItem Header="Reset Model _Settings" Command="{Binding ResetModelSettingsCommand}"/>
                </MenuItem>
                <MenuItem Header="_Options">
                    <MenuItem Header="_Autosave" Command="{Binding ToggleBackyardAutosaveCommand}">
                        <MenuItem.Icon>
                            <CheckBox IsChecked="{Binding BackyardAutosave}" BorderThickness="0"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Always _Link on Import" Command="{Binding ToggleBackyardAlwaysLinkCommand}">
                        <MenuItem.Icon>
                            <CheckBox IsChecked="{Binding BackyardAlwaysLink}" BorderThickness="0"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="_Apply Chat Settings">
                        <MenuItem Header="To _First Chat" Command="{Binding SetBackyardApplyChatSettingsCommand}" CommandParameter="First"/>
                        <MenuItem Header="To _Last Chat" Command="{Binding SetBackyardApplyChatSettingsCommand}" CommandParameter="Last"/>
                        <MenuItem Header="To _All Chats" Command="{Binding SetBackyardApplyChatSettingsCommand}" CommandParameter="All"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Use _Portrait as Background" Command="{Binding ToggleBackyardUsePortraitAsBackgroundCommand}">
                        <MenuItem.Icon>
                            <CheckBox IsChecked="{Binding BackyardUsePortraitAsBackground}" BorderThickness="0"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Import Alternate _Greetings" Command="{Binding ToggleBackyardImportAltGreetingsCommand}">
                        <MenuItem.Icon>
                            <CheckBox IsChecked="{Binding BackyardImportAltGreetings}" BorderThickness="0"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Write _User Persona" Command="{Binding ToggleBackyardWriteUserPersonaCommand}">
                        <MenuItem.Icon>
                            <CheckBox IsChecked="{Binding BackyardWriteUserPersona}" BorderThickness="0"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Write Author _Note" Command="{Binding ToggleBackyardWriteAuthorNoteCommand}">
                        <MenuItem.Icon>
                            <CheckBox IsChecked="{Binding BackyardWriteAuthorNote}" BorderThickness="0"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="View _Help" Command="{Binding ViewHelpCommand}"/>
                <MenuItem Header="Visit _GitHub Page" Command="{Binding VisitGitHubCommand}"/>
                <Separator/>
                <MenuItem Header="Check for _Updates..." Command="{Binding CheckForUpdatesCommand}"/>
                <Separator/>
                <MenuItem Header="_About Ginger" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                Padding="12,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="11"/>
                <!-- Backyard connection indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center"
                            IsVisible="{Binding IsBackyardConnected}">
                    <Ellipse Width="8" Height="8" Fill="{Binding BackyardStatusColor}" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding BackyardStatusText}" FontSize="11"/>
                </StackPanel>
                <!-- Actor selector (shown when multiple actors) -->
                <ComboBox Grid.Column="2" ItemsSource="{Binding Actors}" SelectedItem="{Binding SelectedActor}"
                          Margin="16,0" Padding="8,2" MinWidth="120" FontSize="11"
                          IsVisible="{Binding HasMultipleActors}" x:CompileBindings="False">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <!-- Embedded assets -->
                <TextBlock Grid.Column="3" Text="{Binding EmbeddedAssetCount, StringFormat='Assets: {0}'}" Margin="16,0"
                           VerticalAlignment="Center" FontSize="11"
                           IsVisible="{Binding HasEmbeddedAssets}"/>
                <TextBlock Grid.Column="4" Text="{Binding TokenCount, StringFormat='Tokens: {0}'}" Margin="16,0" VerticalAlignment="Center" FontSize="11"/>
                <TextBlock Grid.Column="5" Text="{Binding LoreCount, StringFormat='Lore: {0}'}" Margin="16,0" VerticalAlignment="Center" FontSize="11"/>
                <TextBlock Grid.Column="6" Text="{Binding RecipeCount, StringFormat='Recipes: {0}'}" Margin="16,0" VerticalAlignment="Center" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid ColumnDefinitions="360,*">

            <!-- Left Sidebar -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,8">

                        <!-- Portrait and Basic Info -->
                        <Grid ColumnDefinitions="140,*" Margin="0,0,0,12">
                            <!-- Portrait -->
                            <Button Grid.Column="0"
                                    Command="{Binding LoadPortraitCommand}"
                                    Padding="0"
                                    Background="#20808080"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                    BorderThickness="1"
                                    Height="140" Width="140"
                                    CornerRadius="2"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    ToolTip.Tip="Click to load portrait image. Drag &amp; drop also supported.">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Load Image..." Command="{Binding LoadPortraitCommand}"/>
                                        <MenuItem Header="Resize (Shrink Large Image)" Command="{Binding ResizePortraitCommand}"
                                                  IsEnabled="{Binding CanResizePortrait}"/>
                                        <Separator/>
                                        <MenuItem Header="Clear" Command="{Binding ClearPortraitCommand}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Panel>
                                    <Image Source="{Binding PortraitImage}" Stretch="Uniform"
                                           Opacity="{Binding IsPortraitFallback, Converter={StaticResource BoolToOpacityConverter}}"/>
                                    <TextBlock Text="(No actor portrait)"
                                               IsVisible="{Binding IsPortraitFallback}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,0,4"
                                               FontSize="10"
                                               Foreground="White"
                                               Background="#80000000"
                                               Padding="4,2"/>
                                    <StackPanel IsVisible="{Binding PortraitImage, Converter={x:Static ObjectConverters.IsNull}}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Spacing="4">
                                        <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="24" Height="24"
                                                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                        <TextBlock Text="Click to add&#x0a;portrait"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   FontSize="10" TextAlignment="Center"/>
                                    </StackPanel>
                                </Panel>
                            </Button>

                            <!-- Card Name / Character Name / Gender -->
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="8">
                                <StackPanel Spacing="2">
                                    <Label Content="Card name"/>
                                    <TextBox Text="{Binding CharacterName}" Watermark="Card name..."/>
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <Label Content="Character name (goes by)"/>
                                    <TextBox Text="{Binding SpokenName}" Watermark="Unnamed"/>
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <Label Content="Gender"/>
                                    <ComboBox ItemsSource="{Binding GenderOptions}"
                                              SelectedItem="{Binding SelectedGender}"
                                              PlaceholderText="(Not set)"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Card Information -->
                        <Expander Header="Card information" IsExpanded="True">
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <Grid ColumnDefinitions="*,8,*">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <Label Content="Created by"/>
                                        <TextBox Text="{Binding Creator}" Watermark="Your name here"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <Label Content="Version"/>
                                        <TextBox Text="{Binding Version}" Watermark="1.0"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="2">
                                    <Label Content="Tags"/>
                                    <TextBox Text="{Binding Tags}" Watermark="Enter tags separated by comma"/>
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <Label Content="Comment"/>
                                    <TextBox Text="{Binding Comment}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Height="60"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <!-- Background Image -->
                        <Expander Header="Background image" IsExpanded="False">
                            <StackPanel Margin="0,8,0,0" Spacing="8">
                                <Grid ColumnDefinitions="100,*">
                                    <!-- Background Preview -->
                                    <Button Grid.Column="0"
                                            Command="{Binding LoadBackgroundCommand}"
                                            Padding="0"
                                            Background="#20808080"
                                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                            BorderThickness="1"
                                            Height="75" Width="100"
                                            CornerRadius="2"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            ToolTip.Tip="Click to load background image">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Load Image..." Command="{Binding LoadBackgroundCommand}"/>
                                                <MenuItem Header="Paste from Clipboard" Command="{Binding PasteBackgroundCommand}"/>
                                                <MenuItem Header="Use Portrait as Background" Command="{Binding UsePortraitAsBackgroundCommand}"/>
                                                <Separator/>
                                                <MenuItem Header="Effects">
                                                    <MenuItem Header="Blur" Command="{Binding BlurBackgroundCommand}"/>
                                                    <MenuItem Header="Darken" Command="{Binding DarkenBackgroundCommand}"/>
                                                    <MenuItem Header="Desaturate" Command="{Binding DesaturateBackgroundCommand}"/>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Clear" Command="{Binding ClearBackgroundCommand}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Panel>
                                            <Image Source="{Binding BackgroundImage}" Stretch="UniformToFill"/>
                                            <StackPanel IsVisible="{Binding BackgroundImage, Converter={x:Static ObjectConverters.IsNull}}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Spacing="2">
                                                <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="16" Height="16"
                                                          Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                                <TextBlock Text="Background"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                           FontSize="9"/>
                                            </StackPanel>
                                        </Panel>
                                    </Button>

                                    <!-- Effect Buttons -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="4">
                                        <Button Content="Use Portrait" Command="{Binding UsePortraitAsBackgroundCommand}"
                                                HorizontalAlignment="Stretch" Padding="8,4"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button Content="Blur" Command="{Binding BlurBackgroundCommand}"
                                                    IsEnabled="{Binding HasBackgroundImage}" Padding="8,4"/>
                                            <Button Content="Darken" Command="{Binding DarkenBackgroundCommand}"
                                                    IsEnabled="{Binding HasBackgroundImage}" Padding="8,4"/>
                                            <Button Content="B&amp;W" Command="{Binding DesaturateBackgroundCommand}"
                                                    IsEnabled="{Binding HasBackgroundImage}" Padding="8,4"
                                                    ToolTip.Tip="Desaturate"/>
                                        </StackPanel>
                                        <Button Content="Clear" Command="{Binding ClearBackgroundCommand}"
                                                IsEnabled="{Binding HasBackgroundImage}"
                                                HorizontalAlignment="Left" Padding="8,4"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- User / Point of View -->
                        <Expander Header="User / Point of view" IsExpanded="True">
                            <Grid ColumnDefinitions="*,8,*" Margin="0,8,0,0">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <Label Content="Placeholder name"/>
                                    <TextBox Text="{Binding UserPlaceholder}" Watermark="User"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <Label Content="Gender"/>
                                    <ComboBox ItemsSource="{Binding GenderOptions}"
                                              SelectedItem="{Binding UserGender}"
                                              PlaceholderText="(Not set)"/>
                                </StackPanel>
                            </Grid>
                        </Expander>

                        <!-- Output Format -->
                        <Expander Header="Output format" IsExpanded="True">
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <Grid ColumnDefinitions="*,8,*">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <Label Content="Text style"/>
                                        <ComboBox ItemsSource="{Binding TextStyleOptions}"
                                                  SelectedItem="{Binding SelectedTextStyle}"
                                                  PlaceholderText="(Not set)"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <Label Content="Detail level"/>
                                        <ComboBox ItemsSource="{Binding DetailLevelOptions}"
                                                  SelectedItem="{Binding SelectedDetailLevel}"
                                                  PlaceholderText="Normal detail"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox Content="Use grammar" IsChecked="{Binding UseGrammar}"/>
                            </StackPanel>
                        </Expander>

                        <!-- Output Settings -->
                        <Expander Header="Output settings" IsExpanded="False">
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <!-- Persona placement -->
                                <StackPanel Spacing="2">
                                    <Label Content="User persona location" FontSize="11"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <RadioButton Content="In Persona" IsChecked="{Binding UserPersonaInPersona}" GroupName="PersonaLocation"/>
                                        <RadioButton Content="In Scenario" IsChecked="{Binding UserPersonaInScenario}" GroupName="PersonaLocation"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Options -->
                                <StackPanel Spacing="2">
                                    <Label Content="Options" FontSize="11"/>
                                    <WrapPanel>
                                        <CheckBox Content="Prune scenario" IsChecked="{Binding PruneScenario}" Margin="0,0,12,4"
                                                  ToolTip.Tip="Remove scenario text from output"/>
                                        <CheckBox Content="Use style grammar" IsChecked="{Binding UseStyleGrammar}" Margin="0,0,12,4"
                                                  ToolTip.Tip="Apply style-based grammar rules"/>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Include/Omit sections -->
                                <StackPanel Spacing="2">
                                    <Label Content="Include in output" FontSize="11"/>
                                    <WrapPanel>
                                        <CheckBox Content="System prompt" IsChecked="{Binding IncludeSystemPrompt}" Margin="0,0,12,4"/>
                                        <CheckBox Content="Personality" IsChecked="{Binding IncludePersonality}" Margin="0,0,12,4"/>
                                        <CheckBox Content="User persona" IsChecked="{Binding IncludeUserPersona}" Margin="0,0,12,4"/>
                                        <CheckBox Content="Scenario" IsChecked="{Binding IncludeScenario}" Margin="0,0,12,4"/>
                                        <CheckBox Content="Example" IsChecked="{Binding IncludeExample}" Margin="0,0,12,4"/>
                                        <CheckBox Content="Greeting" IsChecked="{Binding IncludeGreeting}" Margin="0,0,12,4"/>
                                        <CheckBox Content="Grammar" IsChecked="{Binding IncludeGrammar}" Margin="0,0,12,4"/>
                                        <CheckBox Content="Lorebook" IsChecked="{Binding IncludeLore}" Margin="0,0,12,4"/>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <!-- Statistics -->
                        <Expander Header="Statistics" IsExpanded="False">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,8,0,0">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Total Tokens" FontSize="11"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TokenCount}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Permanent (Faraday)" FontSize="11"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PermanentTokensFaraday}" FontSize="11"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Permanent (SillyTavern)" FontSize="11"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PermanentTokensSillyTavern}" FontSize="11"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Lore Entries" FontSize="11"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LoreCount}" FontSize="11"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Recipes" FontSize="11"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RecipeCount}" FontSize="11"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Actors" FontSize="11"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ActorCount}" FontSize="11"/>
                            </Grid>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Content Area -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">

                <!-- Recipe Category Toolbar -->
                <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <!-- Model Recipes -->
                        <Button Padding="8,4" Background="Transparent" BorderThickness="0">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ScrollViewer MaxHeight="400" MaxWidth="300">
                                        <ItemsControl ItemsSource="{Binding ModelRecipes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddRecipeFromLibraryCommand}"
                                                            CommandParameter="{Binding Id}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Background="Transparent"
                                                            Padding="8,6">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="10" Opacity="0.7"
                                                                       TextWrapping="Wrap" MaxWidth="260"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <PathIcon Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6M12,8A4,4 0 0,0 8,12A4,4 0 0,0 12,16A4,4 0 0,0 16,12A4,4 0 0,0 12,8Z" Width="32" Height="32"/>
                                <TextBlock Text="Model" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Character Recipes -->
                        <Button Padding="8,4" Background="Transparent" BorderThickness="0">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ScrollViewer MaxHeight="400" MaxWidth="300">
                                        <ItemsControl ItemsSource="{Binding CharacterRecipes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddRecipeFromLibraryCommand}"
                                                            CommandParameter="{Binding Id}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Background="Transparent"
                                                            Padding="8,6">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="10" Opacity="0.7"
                                                                       TextWrapping="Wrap" MaxWidth="260"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <PathIcon Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" Width="32" Height="32"/>
                                <TextBlock Text="Character" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Personality/Traits Recipes -->
                        <Button Padding="8,4" Background="Transparent" BorderThickness="0">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ScrollViewer MaxHeight="400" MaxWidth="300">
                                        <ItemsControl ItemsSource="{Binding TraitRecipes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddRecipeFromLibraryCommand}"
                                                            CommandParameter="{Binding Id}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Background="Transparent"
                                                            Padding="8,6">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="10" Opacity="0.7"
                                                                       TextWrapping="Wrap" MaxWidth="260"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <PathIcon Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z" Width="32" Height="32"/>
                                <TextBlock Text="Traits" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Mind/Personality Recipes -->
                        <Button Padding="8,4" Background="Transparent" BorderThickness="0">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ScrollViewer MaxHeight="400" MaxWidth="300">
                                        <ItemsControl ItemsSource="{Binding PersonalityRecipes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddRecipeFromLibraryCommand}"
                                                            CommandParameter="{Binding Id}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Background="Transparent"
                                                            Padding="8,6">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="10" Opacity="0.7"
                                                                       TextWrapping="Wrap" MaxWidth="260"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <PathIcon Data="M12,3C10.73,3 9.6,3.8 9.18,5H6V7H9.18C9.6,8.2 10.73,9 12,9C13.27,9 14.4,8.2 14.82,7H18V5H14.82C14.4,3.8 13.27,3 12,3M12,5A1,1 0 0,1 13,6A1,1 0 0,1 12,7A1,1 0 0,1 11,6A1,1 0 0,1 12,5M6,11V13H9.18C9.6,14.2 10.73,15 12,15C13.27,15 14.4,14.2 14.82,13H18V11H14.82C14.4,9.8 13.27,9 12,9C10.73,9 9.6,9.8 9.18,11H6M12,11A1,1 0 0,1 13,12A1,1 0 0,1 12,13A1,1 0 0,1 11,12A1,1 0 0,1 12,11M6,17V19H9.18C9.6,20.2 10.73,21 12,21C13.27,21 14.4,20.2 14.82,19H18V17H14.82C14.4,15.8 13.27,15 12,15C10.73,15 9.6,15.8 9.18,17H6M12,17A1,1 0 0,1 13,18A1,1 0 0,1 12,19A1,1 0 0,1 11,18A1,1 0 0,1 12,17Z" Width="32" Height="32"/>
                                <TextBlock Text="Mind" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Story Recipes -->
                        <Button Padding="8,4" Background="Transparent" BorderThickness="0">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ScrollViewer MaxHeight="400" MaxWidth="300">
                                        <ItemsControl ItemsSource="{Binding StoryRecipes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddRecipeFromLibraryCommand}"
                                                            CommandParameter="{Binding Id}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Background="Transparent"
                                                            Padding="8,6">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="10" Opacity="0.7"
                                                                       TextWrapping="Wrap" MaxWidth="260"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <PathIcon Data="M19,1L17.74,3.75L15,5L17.74,6.26L19,9L20.25,6.26L23,5L20.25,3.75M9,4L6.5,9.5L1,12L6.5,14.5L9,20L11.5,14.5L17,12L11.5,9.5M19,15L17.74,17.74L15,19L17.74,20.25L19,23L20.25,20.25L23,19L20.25,17.74" Width="32" Height="32"/>
                                <TextBlock Text="Story" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Rectangle Width="1" Fill="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="6,8"/>
                        <!-- Other Recipes -->
                        <Button Padding="8,4" Background="Transparent" BorderThickness="0">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ScrollViewer MaxHeight="400" MaxWidth="300">
                                        <ItemsControl ItemsSource="{Binding OtherRecipes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddRecipeFromLibraryCommand}"
                                                            CommandParameter="{Binding Id}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Background="Transparent"
                                                            Padding="8,6">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="10" Opacity="0.7"
                                                                       TextWrapping="Wrap" MaxWidth="260"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6Z" Width="32" Height="32"/>
                                <TextBlock Text="Other" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Snippets -->
                        <Button Padding="8,4" Background="Transparent" BorderThickness="0">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ScrollViewer MaxHeight="400" MaxWidth="300">
                                        <ItemsControl ItemsSource="{Binding SnippetRecipes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddRecipeFromLibraryCommand}"
                                                            CommandParameter="{Binding Id}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Background="Transparent"
                                                            Padding="8,6">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="10" Opacity="0.7"
                                                                       TextWrapping="Wrap" MaxWidth="260"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <PathIcon Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z" Width="32" Height="32"/>
                                <TextBlock Text="Snippets" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Components -->
                        <Button Padding="8,4" Background="Transparent" BorderThickness="0">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ScrollViewer MaxHeight="400" MaxWidth="300">
                                        <ItemsControl ItemsSource="{Binding ComponentRecipes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddRecipeFromLibraryCommand}"
                                                            CommandParameter="{Binding Id}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Background="Transparent"
                                                            Padding="8,6">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="10" Opacity="0.7"
                                                                       TextWrapping="Wrap" MaxWidth="260"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <PathIcon Data="M3,3H11V11H3V3M3,13H11V21H3V13M13,3H21V11H13V3M13,13H21V21H13V13M5,5V9H9V5H5M5,15V19H9V15H5M15,5V9H19V5H15M15,15V19H19V15H15Z" Width="32" Height="32"/>
                                <TextBlock Text="Components" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Lore -->
                        <Button Padding="8,4" Background="Transparent" BorderThickness="0">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ScrollViewer MaxHeight="400" MaxWidth="300">
                                        <ItemsControl ItemsSource="{Binding LoreRecipes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddRecipeFromLibraryCommand}"
                                                            CommandParameter="{Binding Id}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Background="Transparent"
                                                            Padding="8,6">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="10" Opacity="0.7"
                                                                       TextWrapping="Wrap" MaxWidth="260"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <PathIcon Data="M6,4H8V6H6V4M10,4H12V6H10V4M14,4H16V6H14V4M18,4H20V6H18V4M6,8H8V10H6V8M10,8H12V10H10V8M14,8H16V10H14V8M18,8H20V10H18V8M6,12H8V14H6V12M10,12H12V14H10V12M14,12H16V14H14V12M18,12H20V14H18V12M6,16H8V18H6V16M10,16H12V18H10V16M14,16H16V18H14V16M18,16H20V18H18V16" Width="32" Height="32"/>
                                <TextBlock Text="Lore" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Rectangle Width="1" Fill="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="6,8"/>
                        <Button Padding="8,4" Background="Transparent" BorderThickness="0"
                                Command="{Binding AddRecipeCommand}">
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="32" Height="32"/>
                                <TextBlock Text="Add" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Tab Content with Vertical Tabs -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

                    <!-- Content Area -->
                    <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                        <Panel>
                            <!-- Recipe Tab Content -->
                            <ScrollViewer IsVisible="{Binding IsRecipeTabActive}">
                                <ItemsControl ItemsSource="{Binding Recipes}" Margin="12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Margin="0,0,0,8"
                                                    Padding="0">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Bake" Command="{Binding BakeRecipeCommand}"/>
                                                        <MenuItem Header="Copy Recipe" Command="{Binding CopyCommand}"/>
                                                        <MenuItem Header="Paste Recipes" Command="{Binding PasteCommand}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Save as Snippet..." Command="{Binding SaveAsSnippetCommand}"/>
                                                        <MenuItem Header="Save as Recipe..." Command="{Binding SaveAsRecipeCommand}"/>
                                                        <MenuItem Header="Make Primary Greeting"
                                                                  Command="{Binding MakePrimaryGreetingCommand}"
                                                                  IsVisible="{Binding IsGreeting}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Move Up" Command="{Binding MoveUpCommand}"/>
                                                        <MenuItem Header="Move Down" Command="{Binding MoveDownCommand}"/>
                                                        <MenuItem Header="Move to Top" Command="{Binding MoveToTopCommand}"/>
                                                        <MenuItem Header="Move to Bottom" Command="{Binding MoveToBottomCommand}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Remove" Command="{Binding RemoveCommand}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Expander IsExpanded="{Binding IsExpanded}" Padding="0">
                                                    <Expander.Header>
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,8,0">
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="2" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                                    CornerRadius="3" Padding="6,2" Margin="8,0,0,0"
                                                                    IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowRecipeCategory}"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Category}" FontSize="10" Opacity="0.8"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                                                                <Button Command="{Binding MoveUpCommand}" Padding="4,2" FontSize="10" Background="Transparent">
                                                                    <PathIcon Data="M7,15L12,10L17,15H7Z" Width="12" Height="12"/>
                                                                </Button>
                                                                <Button Command="{Binding MoveDownCommand}" Padding="4,2" FontSize="10" Background="Transparent">
                                                                    <PathIcon Data="M7,10L12,15L17,10H7Z" Width="12" Height="12"/>
                                                                </Button>
                                                                <Button Command="{Binding RemoveCommand}" Padding="4,2" FontSize="10" Background="Transparent">
                                                                    <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Width="12" Height="12"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Expander.Header>
                                                    <StackPanel Margin="12,0,12,12" Spacing="8">
                                                        <!-- Recipe-level controls -->
                                                        <WrapPanel Margin="0,8,0,0">
                                                            <CheckBox Content="NSFW"
                                                                      IsChecked="{Binding IsNsfw}"
                                                                      VerticalAlignment="Center"/>
                                                            <CheckBox Content="Enable formatting"
                                                                      IsChecked="{Binding IsTextFormattingEnabled}"
                                                                      IsVisible="{Binding CanToggleFormatting}"
                                                                      VerticalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <TextBlock Text="Detail:" FontSize="11" VerticalAlignment="Center"/>
                                                                <ComboBox ItemsSource="{Binding DetailLevelOptions}"
                                                                          SelectedItem="{Binding SelectedDetailLevel}"
                                                                          Width="120"/>
                                                            </StackPanel>
                                                            <Button Content="Make Primary Greeting"
                                                                    Command="{Binding MakePrimaryGreetingCommand}"
                                                                    IsVisible="{Binding IsGreeting}"
                                                                    Padding="8,4"/>
                                                        </WrapPanel>
                                                        <!-- Parameters -->
                                                        <ItemsControl ItemsSource="{Binding Parameters}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,4"
                                                                          IsVisible="{Binding !IsHiddenParameter}">
                                                                        <!-- Label -->
                                                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                                                   VerticalAlignment="Top"
                                                                                   Margin="0,6,8,0"
                                                                                   MinWidth="100"
                                                                                   FontSize="11"/>
                                                                        <!-- Value control based on type -->
                                                                        <Panel Grid.Column="1">
                                                                            <!-- Text -->
                                                                            <TextBox Text="{Binding Value}"
                                                                                     IsVisible="{Binding IsTextParameter}"
                                                                                     AcceptsReturn="True"
                                                                                     TextWrapping="Wrap"
                                                                                     MinHeight="24"
                                                                                     FontSize="11"
                                                                                     Watermark="{Binding Description}"/>
                                                                            <!-- Boolean (Toggle) -->
                                                                            <CheckBox IsChecked="{Binding BoolValue}"
                                                                                      IsVisible="{Binding IsBoolParameter}"
                                                                                      Content="{Binding Description}"/>
                                                                            <!-- Number -->
                                                                            <NumericUpDown Value="{Binding NumericValue}"
                                                                                           IsVisible="{Binding IsNumberParameter}"
                                                                                           Minimum="{Binding MinValue}"
                                                                                           Maximum="{Binding MaxValue}"
                                                                                           Increment="{Binding StepValue}"
                                                                                           FontSize="11"/>
                                                                            <!-- Range Slider -->
                                                                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsRangeParameter}">
                                                                                <Slider Grid.Column="0" Value="{Binding SliderValue}"
                                                                                        Minimum="{Binding MinValue}"
                                                                                        Maximum="{Binding MaxValue}"
                                                                                        TickFrequency="{Binding StepValue}"
                                                                                        IsSnapToTickEnabled="True"
                                                                                        VerticalAlignment="Center"/>
                                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                                                                    <TextBlock Text="{Binding NumericValue}" VerticalAlignment="Center" FontSize="11" MinWidth="40"/>
                                                                                    <TextBlock Text="{Binding RangeSuffix}" VerticalAlignment="Center" FontSize="11"/>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                            <!-- Measurement -->
                                                                            <StackPanel Orientation="Horizontal" IsVisible="{Binding IsMeasurementParameter}">
                                                                                <NumericUpDown Value="{Binding NumericValue}"
                                                                                               Minimum="0"
                                                                                               Increment="1"
                                                                                               FontSize="11"
                                                                                               Width="100"/>
                                                                                <TextBlock Text="{Binding MeasurementUnit}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"/>
                                                                            </StackPanel>
                                                                            <!-- Choice -->
                                                                            <ComboBox ItemsSource="{Binding ChoiceOptions}"
                                                                                      SelectedItem="{Binding SelectedOption}"
                                                                                      IsVisible="{Binding IsChoiceParameter}"
                                                                                      FontSize="11"
                                                                                      HorizontalAlignment="Stretch"/>
                                                                            <!-- Actor Choice -->
                                                                            <ComboBox ItemsSource="{Binding ActorChoiceOptions}"
                                                                                      SelectedItem="{Binding SelectedActorChoice}"
                                                                                      IsVisible="{Binding IsActorChoiceParameter}"
                                                                                      FontSize="11"
                                                                                      HorizontalAlignment="Stretch">
                                                                                <ComboBox.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <TextBlock Text="{Binding Label}"/>
                                                                                    </DataTemplate>
                                                                                </ComboBox.ItemTemplate>
                                                                            </ComboBox>
                                                                            <!-- Multi-Choice (Checkboxes) -->
                                                                            <ItemsControl ItemsSource="{Binding MultiChoiceItems}"
                                                                                          IsVisible="{Binding IsMultiChoiceParameter}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel Orientation="Horizontal"/>
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <CheckBox IsChecked="{Binding IsChecked}"
                                                                                                  Content="{Binding Label}"
                                                                                                  Margin="0,0,12,4"
                                                                                                  FontSize="11"/>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                            <!-- List (comma-separated) -->
                                                                            <TextBox Text="{Binding ListValue}"
                                                                                     IsVisible="{Binding IsListParameter}"
                                                                                     AcceptsReturn="True"
                                                                                     TextWrapping="Wrap"
                                                                                     MinHeight="24"
                                                                                     FontSize="11"
                                                                                     Watermark="Enter items separated by commas..."/>
                                                                        </Panel>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <!-- Recipe Content -->
                                                        <TextBox Text="{Binding Content}"
                                                                 AcceptsReturn="True"
                                                                 TextWrapping="Wrap"
                                                                 MinHeight="80"
                                                                 Watermark="Recipe content..."
                                                                 FontSize="12"
                                                                 FontFamily="Consolas,Menlo,Monaco,monospace"/>
                                                    </StackPanel>
                                                </Expander>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Output Tab Content -->
                            <TextBox Text="{Binding OutputPreview}"
                                     IsVisible="{Binding IsOutputTabActive}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Margin="12"
                                     FontSize="12"
                                     FontFamily="Consolas,Menlo,Monaco,monospace"/>

                            <!-- Notes Tab Content -->
                            <TextBox Text="{Binding Notes}"
                                     IsVisible="{Binding IsNotesTabActive}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Watermark="Your notes..."
                                     Margin="12"
                                     FontSize="12"/>

                            <!-- Lorebook Tab Content -->
                            <DockPanel IsVisible="{Binding IsLorebookTabActive}">
                                <Border DockPanel.Dock="Top" Padding="12,8"
                                        BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Text="Lorebook Entries" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Padding="8,4" FontSize="11" Margin="0,0,4,0">
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="Sort by Name" Command="{Binding SortLorebookByNameCommand}"/>
                                                    <MenuItem Header="Sort by Keys" Command="{Binding SortLorebookByKeysCommand}"/>
                                                    <MenuItem Header="Sort by Insertion Order" Command="{Binding SortLorebookByInsertionOrderCommand}"/>
                                                    <MenuItem Header="Sort by Priority" Command="{Binding SortLorebookByPriorityCommand}"/>
                                                    <MenuItem Header="Sort by Token Count" Command="{Binding SortLorebookByTokenCountCommand}"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <PathIcon Data="M3,18H9V16H3V18M3,6V8H21V6H3M3,13H15V11H3V13Z" Width="12" Height="12"/>
                                                <TextBlock Text="Sort"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Command="{Binding AddLorebookEntryCommand}"
                                                Padding="8,4" FontSize="11">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="12" Height="12"/>
                                                <TextBlock Text="Add Entry"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                                <ScrollViewer>
                                    <ItemsControl ItemsSource="{Binding LorebookEntries}" Margin="12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Margin="0,0,0,8"
                                                        Padding="0">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Copy Entry" Command="{Binding CopyEntryCommand}"/>
                                                            <MenuItem Header="Paste Entry" Command="{Binding PasteEntryCommand}"/>
                                                            <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}"/>
                                                            <Separator/>
                                                            <MenuItem Header="Move Up" Command="{Binding MoveUpCommand}"/>
                                                            <MenuItem Header="Move Down" Command="{Binding MoveDownCommand}"/>
                                                            <Separator/>
                                                            <MenuItem Header="Remove" Command="{Binding RemoveCommand}"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Expander IsExpanded="{Binding IsExpanded}" Padding="0">
                                                        <Expander.Header>
                                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,8,0">
                                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}"
                                                                          Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Keys}" FontWeight="SemiBold" FontSize="12"
                                                                               IsVisible="{Binding Keys, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                                    <TextBlock Text="(no keys)" FontStyle="Italic" FontSize="11" Opacity="0.6"
                                                                               IsVisible="{Binding Keys, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                                                    <Button Command="{Binding MoveUpCommand}" Padding="4,2" Background="Transparent">
                                                                        <PathIcon Data="M7,15L12,10L17,15H7Z" Width="12" Height="12"/>
                                                                    </Button>
                                                                    <Button Command="{Binding MoveDownCommand}" Padding="4,2" Background="Transparent">
                                                                        <PathIcon Data="M7,10L12,15L17,10H7Z" Width="12" Height="12"/>
                                                                    </Button>
                                                                    <Button Command="{Binding RemoveCommand}" Padding="4,2" Background="Transparent">
                                                                        <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Width="12" Height="12"/>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Expander.Header>
                                                        <StackPanel Margin="12,0,12,12" Spacing="8">
                                                            <!-- Basic Fields -->
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel Spacing="2">
                                                                    <Label Content="Trigger Keys (comma separated)" FontSize="11"/>
                                                                    <TextBox Text="{Binding Keys}" Watermark="character name, location, item..."
                                                                             FontSize="12"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,0,0">
                                                                    <TextBlock Text="{Binding TokenCount, StringFormat='Tokens: {0}'}"
                                                                               FontSize="10" Opacity="0.7"/>
                                                                </StackPanel>
                                                            </Grid>
                                                            <StackPanel Spacing="2">
                                                                <Label Content="Content" FontSize="11"/>
                                                                <TextBox Text="{Binding Content}"
                                                                         AcceptsReturn="True"
                                                                         TextWrapping="Wrap"
                                                                         MinHeight="80"
                                                                         Watermark="Information to inject when keys are mentioned..."
                                                                         FontSize="12"/>
                                                            </StackPanel>

                                                            <!-- Advanced Settings Expander -->
                                                            <Expander Header="Advanced Settings" IsExpanded="False" Padding="0" Margin="0,4,0,0">
                                                                <StackPanel Spacing="8" Margin="0,8,0,0">
                                                                    <!-- Name and Comment -->
                                                                    <Grid ColumnDefinitions="*,8,*">
                                                                        <StackPanel Spacing="2">
                                                                            <Label Content="Name" FontSize="11"/>
                                                                            <TextBox Text="{Binding Name}" Watermark="Entry name..."
                                                                                     FontSize="12"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2" Spacing="2">
                                                                            <Label Content="Comment" FontSize="11"/>
                                                                            <TextBox Text="{Binding Comment}" Watermark="Notes..."
                                                                                     FontSize="12"/>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <!-- Secondary Keys -->
                                                                    <StackPanel Spacing="2">
                                                                        <Label Content="Secondary Keys (AND logic)" FontSize="11"/>
                                                                        <TextBox Text="{Binding SecondaryKeys}" Watermark="Additional required keywords..."
                                                                                 FontSize="12"/>
                                                                    </StackPanel>

                                                                    <!-- Group -->
                                                                    <StackPanel Spacing="2">
                                                                        <Label Content="Group" FontSize="11"/>
                                                                        <TextBox Text="{Binding Group}" Watermark="Group name..."
                                                                                 FontSize="12"/>
                                                                    </StackPanel>

                                                                    <!-- Position and Order -->
                                                                    <Grid ColumnDefinitions="*,8,*,8,*">
                                                                        <StackPanel Spacing="2">
                                                                            <Label Content="Position" FontSize="11"/>
                                                                            <ComboBox SelectedItem="{Binding Position}" FontSize="12">
                                                                                <ComboBoxItem Content="before_char" Tag="before_char"/>
                                                                                <ComboBoxItem Content="after_char" Tag="after_char"/>
                                                                                <ComboBoxItem Content="before_authors_note" Tag="before_authors_note"/>
                                                                                <ComboBoxItem Content="after_authors_note" Tag="after_authors_note"/>
                                                                                <ComboBoxItem Content="at_depth" Tag="at_depth"/>
                                                                            </ComboBox>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2" Spacing="2">
                                                                            <Label Content="Insertion Order" FontSize="11"/>
                                                                            <NumericUpDown Value="{Binding InsertionOrder}" Minimum="0" Maximum="999"
                                                                                           FontSize="12" FormatString="0"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="4" Spacing="2">
                                                                            <Label Content="Priority" FontSize="11"/>
                                                                            <NumericUpDown Value="{Binding Priority}" Minimum="0" Maximum="999"
                                                                                           FontSize="12" FormatString="0"/>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <!-- Depth (for at_depth position) -->
                                                                    <StackPanel Spacing="2">
                                                                        <Label Content="Depth (for 'at_depth' position)" FontSize="11"/>
                                                                        <NumericUpDown Value="{Binding Depth}" Minimum="0" Maximum="999"
                                                                                       FontSize="12" FormatString="0" Width="100" HorizontalAlignment="Left"/>
                                                                    </StackPanel>

                                                                    <!-- Probability -->
                                                                    <Grid ColumnDefinitions="Auto,8,*">
                                                                        <CheckBox Content="Use Probability" IsChecked="{Binding UseProbability}"
                                                                                  FontSize="11" VerticalAlignment="Center"/>
                                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                                                    IsEnabled="{Binding UseProbability}">
                                                                            <Slider Value="{Binding Probability}" Minimum="0" Maximum="100"
                                                                                    Width="150" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding Probability, StringFormat='{}{0}%'}"
                                                                                       VerticalAlignment="Center" FontSize="11" Width="35"/>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <!-- Flags row -->
                                                                    <WrapPanel>
                                                                        <CheckBox Content="Constant" IsChecked="{Binding Constant}"
                                                                                  FontSize="11" Margin="0,0,16,4"
                                                                                  ToolTip.Tip="Always include this entry"/>
                                                                        <CheckBox Content="Selective" IsChecked="{Binding Selective}"
                                                                                  FontSize="11" Margin="0,0,16,4"
                                                                                  ToolTip.Tip="Require secondary keys to match"/>
                                                                        <CheckBox Content="Case Sensitive" IsChecked="{Binding CaseSensitive}"
                                                                                  FontSize="11" Margin="0,0,16,4"/>
                                                                        <CheckBox Content="Use Regex" IsChecked="{Binding UseRegex}"
                                                                                  FontSize="11" Margin="0,0,16,4"
                                                                                  ToolTip.Tip="Treat keys as regex patterns"/>
                                                                        <CheckBox Content="Exclude Recursion" IsChecked="{Binding ExcludeRecursion}"
                                                                                  FontSize="11" Margin="0,0,16,4"
                                                                                  ToolTip.Tip="Don't scan this entry's content for more matches"/>
                                                                    </WrapPanel>
                                                                </StackPanel>
                                                            </Expander>
                                                        </StackPanel>
                                                    </Expander>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Panel>
                    </Border>

                    <!-- Vertical Tabs -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            BorderThickness="1,0,0,0"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                            Width="28">
                        <StackPanel VerticalAlignment="Top">
                            <Button Command="{Binding ShowRecipeTabCommand}"
                                    Background="{Binding IsRecipeTabActive, Converter={StaticResource TabActiveConverter}}"
                                    Width="28" Height="70"
                                    Padding="0"
                                    CornerRadius="0"
                                    BorderThickness="0">
                                <Panel Width="70" Height="28" RenderTransformOrigin="0.5,0.5">
                                    <Panel.RenderTransform>
                                        <RotateTransform Angle="90"/>
                                    </Panel.RenderTransform>
                                    <TextBlock Text="Recipe" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Panel>
                            </Button>
                            <Button Command="{Binding ShowOutputTabCommand}"
                                    Background="{Binding IsOutputTabActive, Converter={StaticResource TabActiveConverter}}"
                                    Width="28" Height="70"
                                    Padding="0"
                                    CornerRadius="0"
                                    BorderThickness="0">
                                <Panel Width="70" Height="28" RenderTransformOrigin="0.5,0.5">
                                    <Panel.RenderTransform>
                                        <RotateTransform Angle="90"/>
                                    </Panel.RenderTransform>
                                    <TextBlock Text="Output" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Panel>
                            </Button>
                            <Button Command="{Binding ShowNotesTabCommand}"
                                    Background="{Binding IsNotesTabActive, Converter={StaticResource TabActiveConverter}}"
                                    Width="28" Height="70"
                                    Padding="0"
                                    CornerRadius="0"
                                    BorderThickness="0">
                                <Panel Width="70" Height="28" RenderTransformOrigin="0.5,0.5">
                                    <Panel.RenderTransform>
                                        <RotateTransform Angle="90"/>
                                    </Panel.RenderTransform>
                                    <TextBlock Text="Notes" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Panel>
                            </Button>
                            <Button Command="{Binding ShowLorebookTabCommand}"
                                    Background="{Binding IsLorebookTabActive, Converter={StaticResource TabActiveConverter}}"
                                    Width="28" Height="70"
                                    Padding="0"
                                    CornerRadius="0"
                                    BorderThickness="0">
                                <Panel Width="70" Height="28" RenderTransformOrigin="0.5,0.5">
                                    <Panel.RenderTransform>
                                        <RotateTransform Angle="90"/>
                                    </Panel.RenderTransform>
                                    <TextBlock Text="Lore" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Panel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
